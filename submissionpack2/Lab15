// Counter buttons (10 pts)
let count = 0;

// your code here
const decrease = document.getElementById("dec");
const info = document.getElementById("count");
decrease.disabled = true;

function minusClick(e) {
  count--;
  console.log(count);
  info.textContent = count;
  if (count === 0) {
    decrease.disabled = true;
  }
}

function plusClick(e) {
  count++;
  console.log(count);
  info.textContent = count;
  decrease.disabled = false;
}

function resetClick(e) {
  count = 0;
  console.log(count);
  info.textContent = count;
  decrease.disabled = true;
}

document.getElementById("dec").addEventListener("click", minusClick);
document.getElementById("inc").addEventListener("click", plusClick);
document.getElementById("reset").addEventListener("click", resetClick);
// ===== end problem 1 =====

