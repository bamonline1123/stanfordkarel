// Status message (10 pts)
function setStatus(text, ok) {
 const status = document.getElementById("status");
 console.log(status.innerText);
 status.innerText=text;
 if (ok = "banner") {
   status.classList.add("ok");
 } else {
   status.classList.replace("no");
 }
}


