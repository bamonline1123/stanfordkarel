function sweep(k) {
  while (k.frontIsClear()) {
    for (let length = 0; length < 8; length++) {
      if (k.cornerColorIs("Blue")) {
        k.paintCorner("");
        move(k);
      } else {
        if (k.beepersPresent()) {
          k.pickBeeper();
          move(k);
        } else {
          if (k.cornerColorIs("Green")) {
            k.putBeeper();
            move(k);
          } else {
            k.paintCorner("Orange");
            move(k);
          }
        }
      }
    }
    if (k.facingNorth()) {
      if (k.rightIsClear()) {
        turnRight(k);
        move(k);
        turnRight(k);
      }
    } else {
      if (k.facingSouth()) {
        if (k.leftIsClear()) {
          k.turnLeft();
          move(k);
          k.turnLeft();
        }
      }
    }
  }
}
      
      
function main(k) {
  while (k.frontIsClear()) {
    sweep(k);
  }
  faceNorth(k);
  moveAcross(k);
  faceWest(k);
  moveAcross(k);
  faceEast(k);
}

